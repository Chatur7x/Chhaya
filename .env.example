# Use unique random URL-safe values. Never commit .env or certificates.
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
JWT_SECRET=replace-with-at-least-32-random-characters

# Requests per minute: anonymous callers share an IP bucket; verified sessions
# share an account bucket across devices, independent of other users on a NAT.
API_RATE_LIMIT=100
API_AUTH_RATE_LIMIT=600
